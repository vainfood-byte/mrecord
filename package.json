{
  "name": "mrecord",
  "version": "1.1.6",
  "description": "My Record (마이리코드) - 콘텐츠 기록 프로그램",
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vainfood-byte/mrecord.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:publish": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-window": "^2.3.0",
    "virtua": "^0.50.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "rcedit": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.mrecord.app",
    "productName": "My Record",
    "icon": "resources/icons/app-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/app-icon.ico",
      "signAndEditExecutable": false
    },
    "afterPack": "./scripts/after-pack.mjs",
    "nsis": {
      "warningsAsErrors": false,
      "installerIcon": "resources/icons/app-icon.ico",
      "uninstallerIcon": "resources/icons/app-icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vainfood-byte",
        "repo": "mrecord"
      }
    ]
  }
}
